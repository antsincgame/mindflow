# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Storage
SUPABASE_STORAGE_BUCKET_VOICES=voices
SUPABASE_STORAGE_BUCKET_AUDIO=audio

# APNs Configuration
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id
APNS_BUNDLE_ID=com.mindflow.app

# App Configuration
APP_ENVIRONMENT=development
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1

# HealthKit Configuration
HEALTHKIT_ENABLED=true
HEALTHKIT_HEART_RATE_SAMPLE_FREQUENCY=300

# Calendar Integration
CALENDAR_SYNC_INTERVAL=3600
CALENDAR_STRESS_TRIGGER_MINUTES_BEFORE=30

# AI/ML Configuration
AI_STRESS_ANALYSIS_ENABLED=true
AI_RECOMMENDATION_ENGINE_ENABLED=true
AI_MODEL_VERSION=1.0

# Notification Configuration
NOTIFICATION_DEFAULT_INTERVAL_HOURS=4
NOTIFICATION_MIN_INTERVAL_HOURS=1
NOTIFICATION_MAX_INTERVAL_HOURS=8
NOTIFICATION_COOLDOWN_AFTER_REJECTIONS=24
NOTIFICATION_MAX_REJECTIONS_BEFORE_COOLDOWN=3

# Session Configuration
SESSION_MIN_DURATION_SECONDS=60
SESSION_MAX_DURATION_SECONDS=1800
SESSION_DEFAULT_DURATION_SECONDS=300

# Stress Monitoring
STRESS_LEVEL_MIN=1
STRESS_LEVEL_MAX=10
STRESS_CRITICAL_THRESHOLD=8
STRESS_MODERATE_THRESHOLD=5

# Achievement System
ACHIEVEMENT_STREAK_MILESTONE_DAYS=7,14,30,60,90
ACHIEVEMENT_SESSION_MILESTONE_COUNT=10,25,50,100,250

# Audio Configuration
AUDIO_SAMPLE_RATE=44100
AUDIO_BIT_RATE=128000
AUDIO_FORMAT=m4a

# Widget Configuration
WIDGET_REFRESH_INTERVAL_MINUTES=15

# Analytics (Optional)
ANALYTICS_ENABLED=false
ANALYTICS_API_KEY=your-analytics-key

# Debug Configuration
DEBUG_MODE=true
LOG_LEVEL=debug

# Rate Limiting
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=1000

# Background Tasks
BACKGROUND_FETCH_INTERVAL=900
BACKGROUND_SYNC_ENABLED=true

# Security
KEYCHAIN_SERVICE_NAME=com.mindflow.keychain
KEYCHAIN_ACCESS_GROUP=group.com.mindflow.shared

# Feature Flags
FEATURE_VOICE_CUSTOMIZATION=false
FEATURE_BIOMETRIC_MONITORING=true
FEATURE_CALENDAR_INTEGRATION=true
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_ACHIEVEMENTS=true
FEATURE_LOCK_SCREEN_WIDGET=true