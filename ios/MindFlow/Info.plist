	<array>
		<string>com.mindflow.start-exercise</string>
		<string>com.mindflow.view-stats</string>
	</array>
	<key>INIntents</key>
	<array>
		<string>INStartWorkoutIntent</string>
		<string>INPlayMediaIntent</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>health</string>
		<string>x-apple-health</string>
	</array>
</dict>
</plist>